# Copy to .env.local (ignored by git) and adjust.

# Jellyfin server used by the Vite dev proxy under /jellyfin.
# Leave empty to run the app in demo mode with the mock server.
JELLYFIN_DEV_URL=

# Optional overrides for the generated config.js (same names as in the container).
# DEMO_MODE=true
# DEFAULT_THEME=default
# APP_TITLE=Jellymorph
