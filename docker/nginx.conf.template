# Jellymorph site, rendered by docker/entrypoint.sh into /tmp/jellymorph/site.conf.
# Placeholder: JM_LISTEN_IPV6 (the IPv6 listen directive, or nothing). The entrypoint also
# writes the files included from /tmp/jellymorph: headers.conf (security headers incl. CSP),
# proxy.conf (the /jellyfin/ reverse proxy, empty without JELLYFIN_PROXY_TARGET), plugins.conf
# (plugin themes, empty without THEME_PLUGINS) and, in the http context, cache.conf (the
# picture cache, empty without IMAGE_CACHE).

include /tmp/jellymorph/cache.conf;

# Path and query of a /jellyfin/... request without the prefix, exactly as the client sent it.
map $request_uri $jellyfin_rest {
    "~^/jellyfin(?<jellyfin_path>/.*)$" $jellyfin_path;
    default /;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

# Keep the original scheme when another reverse proxy terminates TLS in front of this one.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen 8080 default_server;
    ${JM_LISTEN_IPV6}
    server_name _;
    root /usr/share/nginx/html;
    absolute_redirect off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime configuration written by the entrypoint; never cached.
    location = /config.js {
        alias /tmp/jellymorph/config.js;
        default_type text/javascript;
        include /tmp/jellymorph/headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location = /manifest.webmanifest {
        alias /tmp/jellymorph/manifest.webmanifest;
        types { }
        default_type application/manifest+json;
        include /tmp/jellymorph/headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Content-hashed build output: cache forever. Missing files are a 404, never the app shell,
    # so an outdated tab gets a clear error instead of HTML parsed as JavaScript.
    location /assets/ {
        try_files $uri =404;
        include /tmp/jellymorph/headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /index.html {
        include /tmp/jellymorph/headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # The demo mode's service worker must update together with the app.
    location = /mockServiceWorker.js {
        include /tmp/jellymorph/headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Hidden files (e.g. build metadata) are not part of the app.
    location ~ /\. {
        return 404;
    }

    # Own styles, fonts and pictures from the mounted folder /custom (phase 14). Only these file
    # types; anything else there is a 404. Never cached, so edits apply on the next page load.
    # Plugin themes (THEME_PLUGINS=true): modules and theme.json from /custom/themes.
    include /tmp/jellymorph/plugins.conf;

    location ~ ^/custom/(?<custom_file>[A-Za-z0-9_./-]+\.(?:css|woff2|woff|ttf|otf|png|jpe?g|webp|avif|gif|svg))$ {
        alias /custom/$custom_file;
        include /tmp/jellymorph/headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location /custom/ {
        return 404;
    }

    # Unhashed public files (icons) and the single-page app fallback for every route.
    location / {
        try_files $uri /index.html;
        include /tmp/jellymorph/headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
    }

    include /tmp/jellymorph/proxy.conf;
}
